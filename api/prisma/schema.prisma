generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?          @unique
  password       String?
  createdAt      DateTime        @default(now())
  profilePicture String?
  role           UserRole
  deletedAt      DateTime?
  articles       Article[]
  cleanwalks     CleanwalkUser[]
  organization   Organization?
  refreshTokens  RefreshToken[]
  chatMessages   CleanwalkChatMessage[]
}

model Organization {
  userId       Int       @id
  description  String?
  webSite      String?
  socialMedias Json?
  bannerImg    String?
  lastEvent    DateTime?
  user         User      @relation(fields: [userId], references: [id])
}

model Cleanwalk {
  id           Int             @id @default(autoincrement())
  name         String
  posLat       Float
  posLong      Float
  dateBegin    DateTime
  imgUrl       String?
  duration     Int
  description  String
  address      String
  participantCountPublic Boolean @default(false)
  cityId       Int
  city         City            @relation(fields: [cityId], references: [id])
  participants CleanwalkUser[]
  messages     CleanwalkChatMessage[]
}

model CleanwalkChatMessage {
  id           Int       @id @default(autoincrement())
  cleanwalkId  Int
  // Nom et photo au moment de l'envoi, affichés si l'auteur n'existe plus.
  user         String
  text         String
  avatar       String?
  // Vide pour les messages envoyés avant l'authentification du chat.
  userId       Int?
  createdAt    DateTime  @default(now())
  cleanwalk    Cleanwalk @relation(fields: [cleanwalkId], references: [id], onDelete: Cascade)
  author       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CleanwalkUser {
  userId      Int
  cleanwalkId Int
  nbPerson    Int
  isHost      Boolean
  cleanwalk   Cleanwalk @relation(fields: [cleanwalkId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([userId, cleanwalkId])
}

model Article {
  id             Int               @id @default(autoincrement())
  title          String
  authorId       Int
  content        Json
  createdAt      DateTime          @default(now())
  description    String
  published      Boolean
  previewPicture String?
  author         User              @relation(fields: [authorId], references: [id])
  categories     CategoryArticle[]
}

model City {
  id         Int         @id @default(autoincrement())
  name       String
  cleanwalks Cleanwalk[]
}

model Category {
  id       Int               @id @default(autoincrement())
  category String
  articles CategoryArticle[]
}

model CategoryArticle {
  categoryId Int
  articleId  Int
  article    Article  @relation(fields: [articleId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([categoryId, articleId])
}

// Mots et expressions du filtre du chat, en plus des dictionnaires de leo-profanity.
// Gardés en base plutôt que dans le code pour ne pas publier la liste dans le dépôt.
model ProfanityWord {
  id        Int               @id @default(autoincrement())
  // En minuscules. Avec une espace, c'est une expression de plusieurs mots.
  value     String            @unique
  kind      ProfanityWordKind
  createdAt DateTime          @default(now())
}

enum ProfanityWordKind {
  BLOCK // censuré
  ALLOW // laissé tel quel même s'il est dans un dictionnaire
}

enum UserRole {
  USER
  ADMIN
  ASSOCIATION
}
